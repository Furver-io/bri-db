# BRI Docker Configuration

# Server port
PORT=3000

# Maximum memory for LRU cache (in MB)
MAX_MEMORY_MB=256

# Optional: AES-256-GCM encryption key for data at rest
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=your-64-char-hex-key-here

# Shared access token (at least 16 characters). Required by docker-compose: the server
# listens on all interfaces inside the container and refuses to start without it.
# Generate one and set it here; there is deliberately no default.
#   openssl rand -hex 32
# AUTH_TOKEN=

# Refuse to start without AUTH_TOKEN (set automatically by docker-compose)
AUTH_REQUIRED=true

# Which machine interface docker-compose publishes the port on (default: this machine only)
# BIND_ADDRESS=127.0.0.1

# Optional comma-separated allow-lists
# ALLOWED_HOSTS=db.example.com
# ALLOWED_ORIGINS=https://app.example.com
